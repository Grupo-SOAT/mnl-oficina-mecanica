// Recebe traces (OTLP) do app via 4317 (gRPC) / 4318 (HTTP) e encaminha ao Tempo.
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

// Logs JSON do stdout dos containers -> Loki.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Expõe o container como labels de stream (low-cardinality) para o Loki
// descobrir `service_name` e identificar a origem.
discovery.relabel "labels" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container_name"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}
}

loki.source.docker "containers" {
	host    = "unix:///var/run/docker.sock"
	targets = discovery.relabel.labels.output

	forward_to = [loki.process.app_logs.receiver]
}

// Extrai campos JSON e os publica como structured metadata (baixa cardinalidade),
// para que so_id/trace_id/user_id fiquem pesquisáveis sem inflar o índice de labels.
loki.process "app_logs" {
	stage.json {
		expressions = {
			trace_id = "trace_id",
			user_id  = "user_id",
			so_id    = "so_id",
		}
	}

	stage.structured_metadata {
		values = {
			trace_id = "trace_id",
			user_id  = "user_id",
			so_id    = "so_id",
		}
	}

	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
